    "@wangeditor/editor-for-vue": "^5.1.12",
    "axios": "^1.7.9",
    "core-js": "^3.8.3",
    "dompurify": "^3.2.4",
    "echarts": "^5.6.0",
    "element-plus": "^2.4.4",
    "file-saver": "^2.0.5",
    "mitt": "^3.0.1",
    "sass": "^1.83.4",
    "vue": "^3.4.21",
    "vue-router": "^4.2.5",
    "xlsx": "^0.15.1"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-plugin-router": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "eslint": "^7.32.0",
